[sub_resource type="GDScript" id="GDScript_2j332"]
script/source = "extends Node3D
@onready var rewindable_animation_player: RewindableAnimationPlayer = $RewindableAnimationPlayer


func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"p\"):
		if not rewindable_animation_player.current_animation:
			rewindable_animation_player.play(\"box_rotate\")
"

